# ==============================================================
# College Placement Management System - Environment Variables
# ==============================================================

# Application Port
SERVER_PORT=8080

# Active Spring Profile: 'dev' (zero-config local DB) or 'mysql' (dedicated MySQL server)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Used when profile is set to 'mysql')
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placement_db
DB_USER=root
DB_PASSWORD=your_secure_mysql_password_here

# File Storage Configuration
APP_UPLOAD_DIR=uploads/resumes
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# Custom Domain (When deploying to production)
APP_DOMAIN=placement.college.edu
